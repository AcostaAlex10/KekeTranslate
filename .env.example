# =====================================================================
# KekeTranslate - Variables de entorno
# Copia este archivo a `.env` y rellena tus claves.
# =====================================================================

# ---------------------------------------------------------------------
# 1. PROVEEDOR DE TRANSCRIPCION
# ---------------------------------------------------------------------
# Opciones: assemblyai (recomendado) | deepgram | openai
#
# assemblyai -> 5 GB / 10 h por archivo, diarizacion nativa. Una clase de
#               4 h se envia COMPLETA, sin necesidad de segmentar.
# deepgram   -> nova-3 con diarize=true. Muy rapido, pero conviene usar
#               callbacks para audios muy largos.
# openai     -> Whisper / gpt-4o-transcribe. Tope de 25 MB por peticion,
#               por lo que KekeTranslate segmenta el audio con ffmpeg.
#               NO ofrece identificacion de oradores.
TRANSCRIPTION_PROVIDER=assemblyai

ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Idioma principal de la clase (ISO-639-1). Dejalo vacio para que el
# proveedor detecte el idioma automaticamente.
TRANSCRIPTION_LANGUAGE=es

# Activar identificacion de oradores (diarizacion).
ENABLE_DIARIZATION=true

# Numero aproximado de oradores esperados (opcional, mejora la precision).
# Para una clase magistral suele ser 1-3. Dejalo vacio si no lo sabes.
EXPECTED_SPEAKERS=

# ---------------------------------------------------------------------
# 2. ANOTADOR IA (Claude)
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Claude Opus 5: ventana de contexto de 1M tokens, suficiente para
# procesar una transcripcion de 4 horas en una sola pasada.
ANTHROPIC_MODEL=claude-opus-5

# Profundidad de razonamiento: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# Tokens maximos de salida para los apuntes generados.
ANTHROPIC_MAX_TOKENS=32000

# ---------------------------------------------------------------------
# 3. ALMACENAMIENTO Y LIMITES
# ---------------------------------------------------------------------
STORAGE_DIR=./storage

# Tamano maximo de subida en MB (por defecto 5 GB, el tope de AssemblyAI).
MAX_UPLOAD_MB=5120

# URL del backend que consume el frontend de Streamlit.
BACKEND_URL=http://localhost:8000
